# Storage
DB_PATH=db.sqlite3
SEARCH_LANCEDB_PATH=aggregate_search.lancedb

# qBittorrent Web API
QBIT_URL=http://localhost:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# Bangumi API and optional user collection mirror
BANGUMI_BASE_URL=https://api.bgm.tv
BANGUMI_USER_AGENT=bonsai-manager/0.1.0
BANGUMI_TOKEN=
BANGUMI_USERNAME=
BANGUMI_COLLECTION_TTL_SECONDS=21600

# Aggregate defaults and audit selection
AGGREGATE_CATEGORY=anime
AUDIT_CHECKS=torrent_mapping,collection_coverage
AUDIT_CATEGORIES=anime,RSS,prowlarr
AUDIT_BANGUMI_COLLECTION_TYPES=wish,doing
AUDIT_BANGUMI_COLLECTION_LOCAL_STATES=unmapped,empty

# Semantic search
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_QUERY_PROMPT_MODEL_MARKER=Qwen/Qwen3-Embedding
EMBEDDING_DEVICE=cpu

# Web TUI
WEB_LISTEN=localhost:8000
WEB_TITLE=Bonsai Manager
